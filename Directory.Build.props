<Project>
  <PropertyGroup>
    <Version>0.1.0-preview.20</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Selenium Playwright Migrator Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AlexanderLevenskikh/selenium-playwright-migrator-core</RepositoryUrl>
    <PackageTags>selenium;playwright;roslyn;ast;migration;tests</PackageTags>
  </PropertyGroup>
</Project>
